{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/bill/{**catch-all}"
        }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/user/{**catch-all}"
        }
      },
      "billing-swagger-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/billing-swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      },
      "user-swagger-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/user-swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "billing-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5249"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5137"
          }
        }
      }
    }
  }
}